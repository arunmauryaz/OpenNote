<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="48dp"
    android:layout_marginBottom="6dp"
    android:background="@drawable/bg_settings_card"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="14dp">

    <ImageView
        android:id="@+id/ivPresetIcon"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:src="@drawable/ic_settings_canvas"
        app:tint="#64748B" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvPresetName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Custom Preset Name"
            android:textColor="#0F172A"
            android:textSize="13.5sp"
            android:fontFamily="sans-serif-medium"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvPresetDetails"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="13.333 in × 7.5 in • 16:9 (1.78:1)"
            android:textColor="#64748B"
            android:textSize="11.5sp" />
    </LinearLayout>

    <Button
        android:id="@+id/btnApplyPreset"
        android:layout_width="wrap_content"
        android:layout_height="32dp"
        android:backgroundTint="#0F172A"
        android:paddingHorizontal="12dp"
        android:text="Apply"
        android:textColor="#FFFFFF"
        android:textSize="11.5sp"
        android:fontFamily="sans-serif-medium" />

    <ImageButton
        android:id="@+id/btnDeletePreset"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginStart="6dp"
        android:background="?selectableItemBackgroundBorderless"
        android:contentDescription="Delete Preset"
        android:padding="6dp"
        android:src="@drawable/ic_delete"
        app:tint="#EF4444" />

</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/exportChoiceBackdrop"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#99000000"
    android:padding="32dp">

    <LinearLayout
        android:layout_width="@dimen/dialog_export_choice_width"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:background="@drawable/bg_file_manager_window"
        android:elevation="16dp"
        android:padding="24dp">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp">

            <TextView
                android:id="@+id/tvExportChoiceTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Export as PDF"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:textStyle="bold"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true" />

            <ImageButton
                android:id="@+id/btnExportChoiceClose"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_close"
                app:tint="#8899A6"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:contentDescription="Close" />
        </RelativeLayout>

        <TextView
            android:id="@+id/tvExportChoiceSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Select the export range for this whiteboard document:"
            android:textColor="#8899A6"
            android:textSize="14sp"
            android:layout_marginBottom="20dp" />

        <LinearLayout
            android:id="@+id/btnExportWholeDoc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_settings_card"
            android:padding="16dp"
            android:clickable="true"
            android:focusable="true"
            android:layout_marginBottom="12dp">

            <ImageView
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:src="@drawable/ic_folder"
                app:tint="#3DDC84"
                android:layout_marginEnd="16dp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvWholeDocTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Whole Document"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvWholeDocDesc"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Export all pages in sequence into a multi-page PDF"
                    android:textColor="#8899A6"
                    android:textSize="12sp"
                    android:layout_marginTop="2dp" />
            </LinearLayout>

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_chevron_right"
                app:tint="#8899A6" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/btnExportCustomPages"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_settings_card"
            android:padding="16dp"
            android:clickable="true"
            android:focusable="true"
            android:layout_marginBottom="20dp">

            <ImageView
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:src="@drawable/ic_grid_view"
                app:tint="#4A90E2"
                android:layout_marginEnd="16dp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Custom Pages..."
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvCustomPagesDesc"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Select or deselect specific slides/pages to export"
                    android:textColor="#8899A6"
                    android:textSize="12sp"
                    android:layout_marginTop="2dp" />
            </LinearLayout>

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_chevron_right"
                app:tint="#8899A6" />
        </LinearLayout>

        <Button
            android:id="@+id/btnExportChoiceCancel"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:text="Cancel"
            android:textColor="#FFFFFF"
            android:background="@drawable/bg_pill_button_secondary" />

    </LinearLayout>
</FrameLayout>
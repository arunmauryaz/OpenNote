<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/fmBackdrop"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#44000000">

    <!-- Centered Smaller Modal Window with Curved Edges -->
    <LinearLayout
        android:id="@+id/fmWindowCard"
        android:layout_width="@dimen/dialog_file_manager_width"
        android:layout_height="@dimen/dialog_file_manager_height"
        android:layout_margin="@dimen/dialog_file_manager_margin"
        android:layout_gravity="center"
        android:background="@drawable/bg_file_manager_window"
        android:clipToOutline="true"
        android:elevation="20dp"
        android:orientation="vertical">

        <!-- Top Header Bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/dialog_fm_header_height"
            android:background="#FFFFFF"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="@dimen/dialog_fm_storage_padding"
            android:paddingEnd="@dimen/dialog_fm_storage_padding">

            <ImageView
                android:layout_width="@dimen/dialog_fm_header_icon_size"
                android:layout_height="@dimen/dialog_fm_header_icon_size"
                android:src="@drawable/ic_folder"
                app:tint="#FFA000" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:text="File Manager"
                android:textColor="#1F2937"
                android:textSize="@dimen/dialog_fm_header_title_size"
                android:textStyle="bold" />

            <ImageButton
                android:id="@+id/btnFmClose"
                android:layout_width="@dimen/dialog_fm_header_close_size"
                android:layout_height="@dimen/dialog_fm_header_close_size"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_close"
                app:tint="#9CA3AF" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#E5E7EB" />

        <!-- Main Body: Sidebar + File Browser -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <!-- Left Navigation Sidebar -->
            <LinearLayout
                android:layout_width="@dimen/dialog_file_manager_sidebar_width"
                android:layout_height="match_parent"
                android:background="#F9FAFB"
                android:orientation="vertical"
                android:paddingStart="8dp"
                android:paddingTop="6dp"
                android:paddingEnd="8dp">

                <ScrollView
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:scrollbars="none">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <LinearLayout
                            android:id="@+id/btnFmNew"
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/dialog_fm_sidebar_item_height"
                            android:layout_marginBottom="2dp"
                            android:background="?attr/selectableItemBackground"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingStart="6dp"
                            android:paddingEnd="6dp">

                            <ImageView
                                android:layout_width="@dimen/dialog_fm_sidebar_icon_size"
                                android:layout_height="@dimen/dialog_fm_sidebar_icon_size"
                                android:src="@drawable/ic_add"
                                app:tint="#3B82F6" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:text="Create new file"
                                android:textColor="#374151"
                                android:textSize="@dimen/dialog_fm_sidebar_text_size" />
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/btnFmOpen"
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/dialog_fm_sidebar_item_height"
                            android:layout_marginBottom="2dp"
                            android:background="@drawable/bg_sidebar_pill_active"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingStart="6dp"
                            android:paddingEnd="6dp">

                            <ImageView
                                android:id="@+id/ivFmOpenIcon"
                                android:layout_width="@dimen/dialog_fm_sidebar_icon_size"
                                android:layout_height="@dimen/dialog_fm_sidebar_icon_size"
                                android:src="@drawable/ic_folder"
                                app:tint="#1973E8" />

                            <TextView
                                android:id="@+id/tvFmOpenText"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:text="Open files"
                                android:textColor="#1973E8"
                                android:textSize="@dimen/dialog_fm_sidebar_text_size"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/btnFmSave"
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/dialog_fm_sidebar_item_height"
                            android:layout_marginBottom="2dp"
                            android:background="?attr/selectableItemBackground"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingStart="6dp"
                            android:paddingEnd="6dp">

                            <ImageView
                                android:layout_width="@dimen/dialog_fm_sidebar_icon_size"
                                android:layout_height="@dimen/dialog_fm_sidebar_icon_size"
                                android:src="@drawable/ic_save"
                                app:tint="#3B82F6" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:text="Save"
                                android:textColor="#374151"
                                android:textSize="@dimen/dialog_fm_sidebar_text_size" />
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/btnFmSaveAs"
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/dialog_fm_sidebar_item_height"
                            android:layout_marginBottom="2dp"
                            android:background="?attr/selectableItemBackground"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingStart="6dp"
                            android:paddingEnd="6dp">

                            <ImageView
                                android:layout_width="@dimen/dialog_fm_sidebar_icon_size"
                                android:layout_height="@dimen/dialog_fm_sidebar_icon_size"
                                android:src="@drawable/ic_save_as"
                                app:tint="#3B82F6" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:text="Save as"
                                android:textColor="#374151"
                                android:textSize="@dimen/dialog_fm_sidebar_text_size" />
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/btnFmExportPdf"
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/dialog_fm_sidebar_item_height"
                            android:layout_marginBottom="2dp"
                            android:background="?attr/selectableItemBackground"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingStart="6dp"
                            android:paddingEnd="6dp">

                            <ImageView
                                android:layout_width="@dimen/dialog_fm_sidebar_icon_size"
                                android:layout_height="@dimen/dialog_fm_sidebar_icon_size"
                                android:src="@drawable/ic_pdf"
                                app:tint="#3B82F6" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:text="Export"
                                android:textColor="#374151"
                                android:textSize="@dimen/dialog_fm_sidebar_text_size" />
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/btnFmShare"
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/dialog_fm_sidebar_item_height"
                            android:layout_marginBottom="6dp"
                            android:background="?attr/selectableItemBackground"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingStart="6dp"
                            android:paddingEnd="6dp">

                            <ImageView
                                android:layout_width="@dimen/dialog_fm_sidebar_icon_size"
                                android:layout_height="@dimen/dialog_fm_sidebar_icon_size"
                                android:src="@drawable/ic_share"
                                app:tint="#3B82F6" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:text="Share"
                                android:textColor="#374151"
                                android:textSize="@dimen/dialog_fm_sidebar_text_size" />
                        </LinearLayout>

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_marginBottom="4dp"
                            android:background="#E5E7EB" />

                        <TextView
                            android:id="@+id/tvRecentFilesHeader"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="4dp"
                            android:layout_marginBottom="4dp"
                            android:letterSpacing="0.08"
                            android:text="RECENT FILES"
                            android:textColor="#9CA3AF"
                            android:textSize="9sp"
                            android:textStyle="bold" />

                        <LinearLayout
                            android:id="@+id/layoutRecentFiles"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical" />

                        <TextView
                            android:id="@+id/tvNoRecentFiles"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="4dp"
                            android:text="No recent files"
                            android:textColor="#D1D5DB"
                            android:textSize="10sp"
                            android:visibility="gone" />
                    </LinearLayout>
                </ScrollView>
            </LinearLayout>

            <View
                android:layout_width="1dp"
                android:layout_height="match_parent"
                android:background="#E5E7EB" />

            <!-- Right Browser Panel -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="#FAFAFA"
                android:orientation="vertical">

                <!-- Top Storage Cards Row (Local Drive / SD Card only) -->
                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="#FFFFFF"
                    android:paddingStart="@dimen/dialog_fm_storage_padding"
                    android:paddingTop="6dp"
                    android:paddingEnd="@dimen/dialog_fm_storage_padding"
                    android:paddingBottom="6dp"
                    android:scrollbars="none">

                    <LinearLayout
                        android:id="@+id/layoutStorageCards"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal" />
                </HorizontalScrollView>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#E5E7EB" />

                <!-- Navigation Subheader with Breadcrumb + Tools -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/dialog_fm_subheader_height"
                    android:background="#FAFAFA"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="@dimen/dialog_fm_storage_padding"
                    android:paddingEnd="@dimen/dialog_fm_storage_padding">

                    <HorizontalScrollView
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:scrollbars="none">

                        <LinearLayout
                            android:id="@+id/layoutBreadcrumb"
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            android:gravity="center_vertical"
                            android:orientation="horizontal" />
                    </HorizontalScrollView>

                    <ImageButton
                        android:id="@+id/btnFmRefresh"
                        android:layout_width="@dimen/dialog_fm_subheader_tool_size"
                        android:layout_height="@dimen/dialog_fm_subheader_tool_size"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:src="@drawable/ic_refresh"
                        app:tint="#6B7280" />

                    <ImageButton
                        android:id="@+id/btnFmViewToggle"
                        android:layout_width="@dimen/dialog_fm_subheader_tool_size"
                        android:layout_height="@dimen/dialog_fm_subheader_tool_size"
                        android:layout_marginStart="4dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:src="@drawable/ic_grid_view"
                        app:tint="#6B7280" />

                    <ImageButton
                        android:id="@+id/btnFmSearch"
                        android:layout_width="@dimen/dialog_fm_subheader_tool_size"
                        android:layout_height="@dimen/dialog_fm_subheader_tool_size"
                        android:layout_marginStart="4dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:src="@drawable/ic_search"
                        app:tint="#6B7280" />
                </LinearLayout>

                <!-- "Folders" label -->
                <TextView
                    android:id="@+id/tvSectionLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/dialog_fm_storage_padding"
                    android:layout_marginTop="2dp"
                    android:layout_marginBottom="2dp"
                    android:text="Folders"
                    android:textColor="#9CA3AF"
                    android:textSize="@dimen/dialog_fm_section_label_size"
                    android:textStyle="bold" />

                <!-- Empty State -->
                <LinearLayout
                    android:id="@+id/layoutEmptyState"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <ImageView
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:src="@drawable/ic_folder_outline"
                        app:tint="#D1D5DB" />

                    <TextView
                        android:id="@+id/tvEmptyStateMsg"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:gravity="center"
                        android:text="This folder is empty"
                        android:textColor="#9CA3AF"
                        android:textSize="11sp" />
                </LinearLayout>

                <!-- Grid / List RecyclerView -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvFiles"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:clipToPadding="false"
                    android:paddingStart="6dp"
                    android:paddingTop="2dp"
                    android:paddingEnd="6dp"
                    android:paddingBottom="6dp" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#E5E7EB" />

                <!-- Bottom Action Bar -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/dialog_fm_bottom_height"
                    android:background="#FFFFFF"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="@dimen/dialog_fm_bottom_padding"
                    android:paddingTop="4dp"
                    android:paddingEnd="@dimen/dialog_fm_bottom_padding"
                    android:paddingBottom="4dp">

                    <TextView
                        android:id="@+id/tvCurrentPathDisplay"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:ellipsize="start"
                        android:maxLines="1"
                        android:text=""
                        android:textColor="#6B7280"
                        android:textSize="@dimen/dialog_fm_path_size" />

                    <!-- Slide / PDF Import Mode Toggle (Visible when PDF / Slide is selected) -->
                    <LinearLayout
                        android:id="@+id/layoutImportModeToggle"
                        android:layout_width="wrap_content"
                        android:layout_height="@dimen/dialog_fm_import_toggle_height"
                        android:layout_marginEnd="8dp"
                        android:background="@drawable/bg_pill_toggle_container"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="2dp"
                        android:visibility="gone">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:layout_marginEnd="4dp"
                            android:text="Import as:"
                            android:textColor="#64748B"
                            android:textSize="10.5sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/btnImportAsBg"
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            android:background="@drawable/bg_pill_toggle_active"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center"
                            android:paddingStart="8dp"
                            android:paddingEnd="8dp"
                            android:text="Background"
                            android:textColor="#2563EB"
                            android:textSize="10.5sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/btnImportAsObject"
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            android:background="@android:color/transparent"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center"
                            android:paddingStart="8dp"
                            android:paddingEnd="8dp"
                            android:text="Object"
                            android:textColor="#64748B"
                            android:textSize="10.5sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <Button
                        android:id="@+id/btnFmSecondary"
                        android:layout_width="wrap_content"
                        android:layout_height="@dimen/dialog_fm_action_btn_height"
                        android:layout_marginEnd="6dp"
                        android:background="@drawable/bg_pill_button_secondary"
                        android:gravity="center"
                        android:includeFontPadding="false"
                        android:minWidth="@dimen/dialog_fm_action_btn_min_width"
                        android:minHeight="@dimen/dialog_fm_action_btn_height"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:text="Cancel"
                        android:textAllCaps="false"
                        android:textColor="#334155"
                        android:textSize="@dimen/dialog_fm_action_btn_text_size"
                        android:textStyle="bold"
                        app:backgroundTint="@null" />

                    <Button
                        android:id="@+id/btnFmAction"
                        android:layout_width="wrap_content"
                        android:layout_height="@dimen/dialog_fm_action_btn_height"
                        android:background="@drawable/bg_pill_button_primary"
                        android:gravity="center"
                        android:includeFontPadding="false"
                        android:minWidth="@dimen/dialog_fm_action_btn_min_width"
                        android:minHeight="@dimen/dialog_fm_action_btn_height"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"
                        android:text="Open"
                        android:textAllCaps="false"
                        android:textColor="#FFFFFF"
                        android:textSize="@dimen/dialog_fm_action_btn_text_size"
                        android:textStyle="bold"
                        app:backgroundTint="@null" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>